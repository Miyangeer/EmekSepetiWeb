<div class="row justify-content-center mt-5">
    <div class="col-md-5 p-5 shadow-lg" style="background: var(--card); border-radius: 40px; border: 2px solid var(--soft-purple);">
        <h2 class="text-center fw-bold mb-4" style="color: #b19cd9;">Yeni Hesap</h2>
        <form>
            <div class="mb-3">
                <input type="text" class="form-control border-0 p-3" placeholder="Ad Soyad" style="background: #f8f7ff; border-radius: 15px;">
            </div>
            <div class="mb-3">
                <input type="email" class="form-control border-0 p-3" placeholder="E-Posta" style="background: #f8f7ff; border-radius: 15px;">
            </div>
            <div class="mb-3">
                <input type="tel" class="form-control border-0 p-3" placeholder="Telefon (05xx...)" style="background: #f8f7ff; border-radius: 15px;">
            </div>
            <div class="row mb-4">
                <div class="col-6"><input type="password" class="form-control border-0 p-3" placeholder="Şifre" style="background: #f8f7ff; border-radius: 15px;"></div>
                <div class="col-6"><input type="password" class="form-control border-0 p-3" placeholder="Tekrar" style="background: #f8f7ff; border-radius: 15px;"></div>
            </div>
            <button type="submit" class="btn w-100 p-3 text-white fw-bold shadow" style="background: #b19cd9; border-radius: 20px;">Kayıt Ol</button>
        </form>
    </div>
</div>