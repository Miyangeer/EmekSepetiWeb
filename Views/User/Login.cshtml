<div class="row justify-content-center mt-5">
    <div class="col-md-4 p-5 shadow-lg" style="background: var(--card); border-radius: 40px; border: 2px solid var(--soft-yellow);">
        <h2 class="text-center fw-bold mb-4" style="color: #b19cd9;">Hoş Geldin!</h2>
        <form>
            <div class="mb-3">
                <input type="email" class="form-control border-0 p-3" placeholder="E-Posta" style="background: #f8f7ff; border-radius: 15px;">
            </div>
            <div class="mb-4">
                <input type="password" class="form-control border-0 p-3" placeholder="Şifre" style="background: #f8f7ff; border-radius: 15px;">
            </div>
            <button type="submit" class="btn w-100 p-3 text-white fw-bold shadow" style="background: #b19cd9; border-radius: 20px;">Giriş Yap</button>
        </form>
    </div>
</div>