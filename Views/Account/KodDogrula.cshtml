@{
    ViewData["Title"] = "Kodu Doğrula";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-5">
                    <h3 class="fw-bold text-center mb-3">Kodu Doğrula 🗝️</h3>
                    <p class="text-muted text-center small mb-4">Lütfen telefonunuza SMS ile gelen kodu ve yeni şifrenizi girin.</p>

                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger small text-center">@ViewBag.Hata</div>
                    }

                    <form asp-action="KodDogrula" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Telefonunuza Gelen 6 Haneli Kod</label>
                            <input type="text" name="GirilenKod" class="form-control text-center fs-4 fw-bold" placeholder="000000" maxlength="6" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary">Yeni Şifreniz</label>
                            <div class="input-group">
                                <input type="password" id="newPassword" name="YeniSifre" class="form-control" placeholder="••••••••" required />
                                <button class="btn btn-outline-secondary bg-white border-start-0" type="button" id="btnToggleNewPassword" style="z-index: 10;">
                                    <span id="iconNewPassword" style="font-size: 1.2rem;">👁️</span>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 p-2 text-white border-0" style="background: linear-gradient(to right, #11998e, #38ef7d);">
                            Şifremi Güncelle ve Kaydet
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const newPassword = document.getElementById('newPassword');
        const btnToggleNewPassword = document.getElementById('btnToggleNewPassword');
        const iconNewPassword = document.getElementById('iconNewPassword');

        btnToggleNewPassword.addEventListener('click', () => {
            if (newPassword.type === 'password') {
                // Şifreyi aç -> İkon maymun olsun
                newPassword.type = 'text';
                iconNewPassword.innerText = '🙈';
            } else {
                // Şifreyi kapat -> İkon normal göz olsun
                newPassword.type = 'password';
                iconNewPassword.innerText = '👁️';
            }
        });
    </script>
}