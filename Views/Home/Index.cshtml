@model IEnumerable<EmekSepetiWeb.Models.Urun>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-dark">El Emeği Göz Nuru Ürünler</h1>
            <p class="col-md-8 fs-4 mx-auto text-muted">Üreticiden doğrudan tüketiciye, sevgiyle hazırlanan en doğal ve özgün ürünlerin pazar yeri.</p>
            <a asp-controller="Product" asp-action="Ekle" class="btn btn-primary btn-lg shadow" style="background: linear-gradient(to right, #764ba2, #667eea); border: none;">
                <i class="bi bi-plus-circle"></i> Sen de Ürününü Sat
            </a>
        </div>
    </div>

    <h2 class="mb-4 fw-bold text-secondary"><i class="bi bi-bag-heart"></i> Son Eklenen Ürünler</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5 rounded-3" role="alert">
            <i class="bi bi-info-circle display-4 d-block mb-3"></i>
            <h4 class="alert-heading">Henüz Ürün Eklenmemiş!</h4>
            <p>Sistemde henüz satışa sunulan bir ürün bulunmuyor. Giriş yapıp ilk ürünü sen ekleyebilirsin!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var urun in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative">
                        <img src="@(string.IsNullOrEmpty(urun.ResimUrl) ? "https://images.unsplash.com/photo-1513519245088-0e12902e5a38?q=80&w=500" : urun.ResimUrl)"
                             class="card-img-top" alt="@urun.Ad" style="height: 220px; object-fit: cover;">

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2">@urun.Ad</h5>
                            <p class="card-text text-muted small text-truncate-2" style="height: 45px;">@urun.Aciklama</p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="fs-4 fw-bold text-success">@urun.Fiyat.ToString("C2")</span>
                                <span class="badge bg-light text-dark border p-2">
                                    <i class="bi bi-person"></i> @urun.UygulamaKullanicisi?.Ad @urun.UygulamaKullanicisi?.Soyad
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 p-3">
                            @if (!string.IsNullOrEmpty(urun.UygulamaKullanicisi?.PhoneNumber))
                            {
                                <a href="tel:@urun.UygulamaKullanicisi.PhoneNumber" class="btn btn-outline-primary w-100 rounded-2">
                                    <i class="bi bi-telephone"></i> Satıcıyı Ara (@urun.UygulamaKullanicisi.PhoneNumber)
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100 rounded-2" disabled>
                                    <i class="bi bi-telephone-x"></i> Telefon Belirtilmemiş
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>