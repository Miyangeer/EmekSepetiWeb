@model IEnumerable<EmekSepetiWeb.Models.Urun>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-4">
    <div class="row">
        
        <!-- SOL TARAF: KATEGORİ MENÜSÜ -->
        <div class="col-md-3">
            <h4 class="mb-3">Kategoriler</h4>
            <div class="list-group">
                <!-- Hepsini Göster Butonu -->
                <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action">
                    Tüm Ürünler
                </a>
                
                <!-- Sabit Kategorilerimiz (Veritabanındaki ID'lere göre link veriyoruz) -->
                <a href="@Url.Action("Index", "Home", new { kategoriId = 1 })" class="list-group-item list-group-item-action">
                    🍳 Ev Yemekleri & Gıda
                </a>
                <a href="@Url.Action("Index", "Home", new { kategoriId = 2 })" class="list-group-item list-group-item-action">
                    📿 Takı & Aksesuar
                </a>
                <a href="@Url.Action("Index", "Home", new { kategoriId = 3 })" class="list-group-item list-group-item-action">
                    🧸 Ahşap & Oyuncak
                </a>
            </div>
        </div>

        <!-- SAĞ TARAF: ÜRÜN VİTRİNİ (KARTLAR) -->
        <div class="col-md-9">
            <h4 class="mb-3">El Emeği Ürünler</h4>
            
            @if (!Model.Any())
            {
                <div class="alert alert-warning">Bu kategoride henüz ürün bulunmamaktadır.</div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var urun in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <!-- Ürün Resmi -->
                                <img src="/images/@urun.ResimUrl" class="card-img-top" alt="@urun.Ad" style="height: 200px; object-fit: cover;" onerror="this.src='https://placehold.co/600x400?text=Görsel+Yok'">
                                <div class="card-body">
                                    <h5 class="card-title text-truncate">@urun.Ad</h5>
                                    <p class="card-text text-muted text-truncate">@urun.Aciklama</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="badge bg-success fs-6">@urun.Fiyat.ToString("C2")</span>
                                        <small class="text-muted">
                                            👤 <!-- Sadece kullanıcı adını sildik, yerine bu formu koyuyoruz -->
                                            <form asp-controller="Cart" asp-action="SepeteEkle" method="post" class="mt-2">
                                                <input type="hidden" name="urunId" value="@urun.Id" />
                                                <div class="d-grid">
                                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                                        🛒 Sepete Ekle
                                                    </button>
                                                </div>
                                            </form>
                                        </small>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-top-0">
                                    <button class="btn btn-outline-primary btn-sm w-100">Detayları Gör</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>