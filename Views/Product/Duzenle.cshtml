@model EmekSepetiWeb.Models.Urun

@{
    ViewData["Title"] = "Ürünü Düzenle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">✏️ Ürün Bilgilerini Güncelle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Duzenle" method="post">
                        <!-- Gizli ID Alanı -->
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ürün Adı</label>
                            <input asp-for="Ad" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea asp-for="Aciklama" class="form-control" rows="3" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Fiyat (TL)</label>
                            <input asp-for="Fiyat" type="number" step="0.01" class="form-control" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">💾 Değişiklikleri Kaydet</button>
                            <a asp-action="Urunlerim" class="btn btn-secondary">İptal Et</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>