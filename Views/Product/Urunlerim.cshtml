@model IEnumerable<EmekSepetiWeb.Models.Urun>

@{
    ViewData["Title"] = "Ürün Yönetimi";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-briefcase text-secondary me-2"></i> Benim El Emeği Ürünlerim</h2>
        <a asp-controller="Product" asp-action="Ekle" class="btn btn-success rounded-3 shadow-sm px-4">
            <i class="fa-solid fa-plus me-1"></i> Yeni Ürün Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm rounded-3">Henüz satışta bir ürününüz bulunmuyor. Yukarıdaki butonu kullanarak ilk ilanınızı verebilirsiniz!</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">Görsel</th>
                        <th>Ürün Adı</th>
                        <th>Fiyat</th>
                        <th>Kategori Türü</th>
                        <th style="width: 200px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var urun in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    string urunlerimResimYolu = urun.ResimUrl ?? "";
                                    if (!urunlerimResimYolu.StartsWith("/") && !urunlerimResimYolu.StartsWith("http"))
                                    {
                                        urunlerimResimYolu = "/images/" + urunlerimResimYolu;
                                    }
                                }
                                <img src="@urunlerimResimYolu" class="rounded-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='https://placehold.co/100?text=Görsel+Yok'">
                            </td>
                            <td><strong class="text-dark">@urun.Ad</strong></td>
                            <td><span class="text-success fw-bold">@urun.Fiyat.ToString("C2")</span></td>

                            <td>
                                @if (urun.Kategori != null)
                                {
                                    // Kategori tipine göre jürinin gözünü yormayacak çok tatlı soft renkler atadık
                                    string badgeClass = urun.KategoriId == 1 ? "bg-warning text-dark" :
                                    urun.KategoriId == 2 ? "bg-info text-dark" :
                                    "bg-secondary text-white";

                                    <span class="badge @badgeClass fw-semibold px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.85rem;">
                                        @urun.Kategori.Ad
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">Belirsiz Kategori</span>
                                }
                            </td>

                            <td>
                                <a asp-controller="Product" asp-action="Duzenle" asp-route-id="@urun.Id" class="btn btn-primary btn-sm rounded-3 me-1 px-3">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> Düzenle
                                </a>
                                <a asp-controller="Product" asp-action="Sil" asp-route-id="@urun.Id" class="btn btn-danger btn-sm rounded-3 px-3" onclick="return confirm('Bu el emeği ürünü silmek istediğinize emin misiniz?')">
                                    <i class="fa-solid fa-trash me-1"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>