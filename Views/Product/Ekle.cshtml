@model EmekSepetiWeb.Models.Urun

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header text-white text-center p-4" style="background: linear-gradient(to right, #764ba2, #667eea);">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-bag-plus"></i> Yeni El Emeği Ürün Ekle</h3>
                </div>
                <div class="card-body p-5 bg-light">
                    <form asp-action="Ekle" method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label asp-for="Ad" class="form-label fw-bold text-secondary">Ürün Adı</label>
                            <input asp-for="Ad" class="form-control" placeholder="Örn: El Örgüsü Atkı, Ev Yapımı Tarhana" required />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Aciklama" class="form-label fw-bold text-secondary">Açıklama</label>
                            <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="Ürününüzü kısaca tanıtın..." required></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Fiyat" class="form-label fw-bold text-secondary">Fiyat (TL)</label>
                                <input asp-for="Fiyat" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Ürünün Kategorisi</label>
                                <select asp-for="KategoriId" class="form-select" required>
                                    <option value="">-- Lütfen bir kategori seçin --</option>
                                    @if (ViewBag.Kategoriler != null)
                                    {
                                        foreach (var kategori in ViewBag.Kategoriler)
                                        {
                                            <!-- KategoriAdi yerine sadece Ad yazdık -->
                                            <option value="@kategori.Id">@kategori.Ad</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold text-secondary">Ürün Fotoğrafı Seç</label>
                                <input type="file" name="ResimDosyasi" class="form-control" accept="image/*" />
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Vazgeç</a>
                            <button type="submit" class="btn btn-primary px-5 text-white" style="background: linear-gradient(to right, #764ba2, #667eea); border: none;">Yayınla</button>
                        </div>
                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>